APP_NAME="Pulse Tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pulsetickets.onrender.com
APP_TIMEZONE=Africa/Accra

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ticketing
# DB_USERNAME=ticketing
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CHANNELS=mobile_money
PAYSTACK_CALLBACK_URL="${APP_URL}/checkout/return"
PAYSTACK_WEBHOOK_URL="${APP_URL}/api/v1/momo/webhook"

PLATFORM_COMMISSION_BPS=2000
HOLD_MINUTES=10
DEMO_MODE=false
