APP_NAME="Novara Tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://online-ticket-c5mz.onrender.com
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ticketing
# DB_USERNAME=ticketing
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ImageKit media hosting (preferred production storage for uploaded files).
# Leave these empty locally unless you want the app to use ImageKit in dev too.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=

# Where uploaded files are written. The boot script sets this to the mounted
# disk (/var/data/app/public) on Render, because the container filesystem is
# erased on every deploy.
# PUBLIC_STORAGE_ROOT=/var/data/app/public

# Password reset links are delivered by mail. Use smtp (or a Laravel mail
# transport) in production so buyers can recover their account.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="novaratechafrica@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CHANNELS=mobile_money
PAYSTACK_CURRENCY=UGX
PAYSTACK_CALLBACK_URL="${APP_URL}/checkout/return"
PAYSTACK_WEBHOOK_URL="${APP_URL}/api/v1/momo/webhook"

# Mobile Money gateway.
# MOMO_GATEWAY selects the provider that settles the checkout:
#   mtn      → the MTN MoMo Collections API (direct, Uganda only)
#   paystack → Paystack Mobile Money (MTN and Airtel)
# MOMO_MODE must stay "live" on a production deployment: any other value
# disables payments instead of faking them.
MOMO_GATEWAY=mtn
MOMO_MODE=live
# The providers whose callbacks the webhook endpoint accepts.
MOMO_WEBHOOK_PROVIDERS=mtn

# MTN MoMo Collections API. Copy the base URL, the target environment and the
# subscription keys from the MTN developer portal. The keys are secret: keep
# them in the Render environment, never in the repository.
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_PRIMARY_KEY=
MTN_SECONDARY_KEY=
MTN_TARGET_ENVIRONMENT=UgxAndMore
MTN_CALLBACK_URL="${APP_URL}/api/v1/momo/webhook"
MTN_CURRENCY=UGX
MTN_PAYEE="Novara"
# Optional shared secret checked on top of the MTN payment confirmation.
MTN_WEBHOOK_SECRET=

PLATFORM_COMMISSION_BPS=2000
HOLD_MINUTES=10
DEMO_MODE=false
PLATFORM_CURRENCY=UGX
PLATFORM_COUNTRY=Uganda
PLATFORM_COUNTRY_CODE=UG
PLATFORM_COUNTRY_FLAG=🇺🇬

# Novara Tech Africa — public brand surface.
BRAND_NAME="Novara Tickets"
BRAND_COMPANY="Novara Tech Africa"
BRAND_TAGLINE="Everything by Novara."
BRAND_EMAIL=novaratechafrica@gmail.com
BRAND_WHATSAPP=+256765866555
BRAND_WHATSAPP_LINK=https://wa.me/256765866555
BRAND_INSTAGRAM="https://www.instagram.com/novara_tech_uganda?dlrf=azN4ZW9kdnBkOHFr"
BRAND_WEBSITE=https://novara-tech-africa.kesug.com

# Administrator provisioned by `php artisan ticketing:install` on every deploy.
# Leave the password empty locally to use the seeded demo password.
ADMIN_EMAIL=mwesigwagershom7@gmail.com
ADMIN_PASSWORD=
